<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SubscriptionManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#101114</item>
        <!-- Dark theme: white icons in status/nav bar (false = light/white icons) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.SubscriptionManager.Starting" parent="Theme.SubscriptionManager">
        <item name="android:windowBackground">#101114</item>
    </style>
</resources>
