<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SubscriptionManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F9F7F2</item>
        <!-- Light theme: dark icons in status/nav bar (true = dark icons on light background) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.SubscriptionManager.Starting" parent="Theme.SubscriptionManager">
        <item name="android:windowBackground">#F9F7F2</item>
    </style>
</resources>
